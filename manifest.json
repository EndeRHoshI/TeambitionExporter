{
  "manifest_version": 3,
  "name": "Teambition 本地问题单导出",
  "version": "1.0.0",
  "description": "选择本地目录，导出 Teambition 问题描述、截图与日志附件。",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "clipboardWrite",
    "storage",
    "offscreen",
    "alarms",
    "notifications"
  ],
  "action": {
    "default_title": "提取当前 Teambition 问题单",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "24": "assets/icons/icon24.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "host_permissions": [
    "https://www.teambition.com/*",
    "https://teambition-file.oss-cn-zhangjiakou.aliyuncs.com/*"
  ],
  "minimum_chrome_version": "116",
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
